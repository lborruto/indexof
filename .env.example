# indexof settings. Copy this file to .env next to compose.yaml and fill it in; compose reads
# it by itself. Everything but the two secrets has a default.

# The page's password (required).
INDEXOF_PASSWORD=

# The key the temporary links (open in VLC) are signed with: 32 characters or more, random,
# never the password (required). Make one with: openssl rand -hex 32
INDEXOF_LINK_SECRET=

# Where the page listens. 127.0.0.1 keeps it to this machine (a reverse proxy or a VPN in front
# of it); 0.0.0.0 opens it to the network the machine is on.
INDEXOF_BIND=127.0.0.1
INDEXOF_PORT=8099

# The user and group the containers run as: the owner of the folders you mount (id -u, id -g).
PUID=1000
PGID=1000

# The scp commands (optional): [scp] on each file, and the scp line at the bottom of a writable
# folder. The ssh destination of the machine the folders are on (user@host or host, as you would
# type it after scp) and the folder there that holds them, so that /data/share in the container
# is INDEXOF_SCP_ROOT/share on that machine (/data, the container's own place, when empty). No
# INDEXOF_SCP: no scp commands.
INDEXOF_SCP=
INDEXOF_SCP_ROOT=
