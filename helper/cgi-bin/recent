#!/bin/sh
# The recent files: the 50 last modified in the mounted folders under /data, newest first,
# listed like nginx's listing (as the search's results). Files only: no folder, no symbolic
# link (find -type f does not follow them); hidden names, the refused _ folders and names
# holding a line break left out, with what is under them, as in the search.
# shellcheck source=helper/cgi-bin/lib.sh
. "$(dirname "$0")/lib.sh"
printf 'Content-Type: text/html; charset=utf-8\r\n\r\n'
nl=$(printf '\nx'); nl=${nl%x}
# newest [FIND-TEST...]: the 50 newest files (their modification time, a space, their path), within the
# helper's time (nginx waits 120 s): what was seen by then.
newest() {
  timeout 55 find /data -mindepth 1 '(' -name '.*' -o -path '/data/_*' -o -name "*$nl*" ')' -prune -o -type f "$@" -exec stat -c '%Y %n' {} + 2>/dev/null |
    sort -k1,1nr | head -n 50
}
# The last 90 days first (fewer to sort); everything when they hold fewer than 50.
list=$(newest -mtime -90)
[ "$(printf '%s' "$list" | grep -c .)" -lt 50 ] && list=$(newest)
echo '<html><head><title>Recent</title></head><body><h1>Recent</h1><hr>'
printf '%s\n' "$list" | sed 's/^[0-9]* //' | listing 50
echo '</body></html>'
