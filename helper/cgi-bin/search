#!/bin/sh
printf 'Content-Type: text/html; charset=utf-8\r\n\r\n'
# The form's values, each decoded and cut down to harmless characters.
q= in= type= kind= max=
set -f # the values are not file patterns
IFS='&'
for kv in $QUERY_STRING; do
  v=$(httpd -d "$(printf '%s' "${kv#*=}" | tr '+' ' ')")
  case "$kv" in
    q=*) q=$(printf '%s' "$v" | tr -cd 'A-Za-z0-9 ._()\200-\377-') ;;
    in=*) in=$(printf '%s' "$v" | tr -cd 'A-Za-z0-9 ._()/\200-\377-') ;;
    type=*) type=$v ;;
    kind=*) kind=$v ;;
    max=*) max=$v ;;
  esac
done
unset IFS
set +f
case "$type" in f|d) ;; *) type= ;; esac
case "$max" in 100|500|1000|2000) ;; *) max=500 ;; esac
case "$kind" in
  video) exts='mkv mp4 avi m4v mov webm ts wmv' ;;
  subtitles) exts='srt ass ssa sub vtt idx' ;;
  audio) exts='mp3 flac m4a aac ogg opus wav' ;;
  images) exts='jpg jpeg png gif webp bmp' ;;
  archives) exts='zip 7z rar tar gz xz iso' ;;
  games) exts='nds 3ds cia gba gb gbc nes sfc smc n64 z64 nsp xci' ;;
  *) kind= exts= ;;
esac
# The folder to search: a real folder under /data (media and share), not a hidden one.
base=/data
if [ -n "$in" ]; then
  d=$(realpath "/data/$in" 2>/dev/null)
  case "$d" in /data/*) [ -d "$d" ] && base=$d ;; esac
fi
rel=${base#/data}; rel=${rel#/}
case "/$rel" in */.*) base=/data rel= ;; esac

esc() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'; }
relhtml=$(printf '%s' "$rel" | esc)
opt() { printf '<option value="%s"%s>%s</option>' "$1" "$([ "$1" = "$3" ] && echo ' selected')" "$2"; }
echo "<html><head><title>Search${q:+: $q}</title></head><body><h1>Search${q:+: $q}${rel:+ in /$relhtml/}</h1><hr><pre><form action=\"/_search\">"
printf 'Search: <input name="q" value="%s" size="30" autofocus>  in: <select name="in"><option value="">everywhere</option>' "$q"
cur=$(printf '%s' "$rel" | esc)
{ find /data -mindepth 1 -maxdepth 2 -type d ! -path '*/.*'; [ -n "$rel" ] && echo "$base"; } | sed 's|^/data/||' | sort -u |
  while IFS= read -r f; do e=$(printf '%s' "$f" | esc); opt "$e" "$e" "$cur"; done
printf '</select>  type: <select name="type">%s%s%s</select>' "$(opt '' all "$type")" "$(opt f files "$type")" "$(opt d folders "$type")"
printf '  kind: <select name="kind">%s' "$(opt '' any "$kind")"
for k in video subtitles audio images archives games; do opt "$k" "$k" "$kind"; done
printf '</select>  max: <select name="max">'
for m in 100 500 1000 2000; do opt "$m" "$m" "$max"; done
echo '</select>  <input type="submit" value="Search"></form></pre><hr>'

# The results: like nginx's listing (link, date, size), at most $max.
if [ ${#q} -ge 2 ] || [ -n "$kind" ]; then
  set -- "$base" -mindepth 1 -name '.*' -prune -o
  [ -n "$type" ] && set -- "$@" -type "$type"
  [ -n "$q" ] && set -- "$@" -iname "*$q*"
  if [ -n "$exts" ]; then
    set -- "$@" '('; o=
    for e in $exts; do set -- "$@" $o -iname "*.$e"; o=-o; done
    set -- "$@" ')'
  fi
  echo "<pre id=\"list\" data-max=\"$max\">"
  find "$@" -print 2>/dev/null | head -n "$max" |
  while IFS= read -r f; do stat -c '%F|%s|%Y|%n' "$f"; done | awk -F'|' '
    BEGIN { for (i = 0; i < 256; i++) ord[sprintf("%c", i)] = i }
    function enc(s,  r, i, c) { r = ""; for (i = 1; i <= length(s); i++) { c = substr(s, i, 1); r = r (c ~ /[A-Za-z0-9\/._~-]/ ? c : sprintf("%%%02X", ord[c])) } return r }
    function esc(s) { gsub(/&/, "\\&amp;", s); gsub(/</, "\\&lt;", s); gsub(/>/, "\\&gt;", s); gsub(/"/, "\\&quot;", s); return s }
    function human(n,  i) { if (n < 1024) return n; for (i = 0; n >= 1024 && i < 4; i++) n /= 1024; return int(n + 0.5) substr("KMGT", i, 1) }
    { path = substr($0, length($1 $2 $3) + 10); dir = $1 == "directory"; if (dir) path = path "/"
      pad = 51 - length(path); if (pad < 1) pad = 1
      printf "<a href=\"/%s\">%s</a>%" pad "s%s %8s\n", enc(path), esc(path), "", strftime("%d-%b-%Y %H:%M", $3), dir ? "-" : human($2) }'
  echo "</pre><hr>"
fi
echo "</body></html>"
